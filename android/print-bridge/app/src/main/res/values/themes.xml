<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 light theme — single theme, no dark variant for
         the MVP.  Status bar matches the brand primary so the bridge
         feels like part of the Zahran ecosystem. -->
    <style name="Theme.PrintBridge"
        parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_accent</item>
        <item name="colorOnSecondary">#ffffff</item>
        <item name="android:statusBarColor" tools:targetApi="l">
            @color/brand_primary_dark
        </item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
