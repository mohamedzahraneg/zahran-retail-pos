<?xml version="1.0" encoding="utf-8"?>
<!--
    Main activity layout — RTL-first because the Zahran ecosystem is
    Arabic.  Single ScrollView so small screens still see every section.

    Sections (top → bottom):
        1. Bridge running status + URL
        2. Permissions panel (BT + Notifications)
        3. Paired printer list (RecyclerView would be heavier; for the
           ≤ 10 printers a phone is realistically paired with, a
           plain LinearLayout populated programmatically is fine)
        4. Selected printer + Test Print button
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="#f8fafc">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── 1. Status card ────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_running_fg"
                    android:background="@color/status_running_bg"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="@string/status_running" />

                <TextView
                    android:id="@+id/text_status_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:fontFamily="monospace"
                    android:layoutDirection="ltr"
                    android:gravity="center"
                    android:textIsSelectable="true"
                    tools:ignore="UnusedAttribute"
                    android:text="http://127.0.0.1:8911" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── 2. Permissions ─────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:text="@string/permissions_section_title" />

                <TextView
                    android:id="@+id/text_perm_bt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:text="@string/permission_bt_denied" />

                <TextView
                    android:id="@+id/text_perm_notif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="@string/permission_notif_denied" />

                <Button
                    android:id="@+id/btn_grant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_grant_permissions" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── 3. Paired printers ─────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:text="@string/printer_section_title" />
                    <Button
                        android:id="@+id/btn_scan"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/printer_scan" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_printers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/text_no_printers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@color/border"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:text="@string/printer_none" />

                <Button
                    android:id="@+id/btn_open_bt_settings"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_open_settings" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── 4. Selected printer + test print ───────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="@string/printer_selected_label" />
                    <TextView
                        android:id="@+id/text_selected_printer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="14sp"
                        android:text="@string/printer_none_selected" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test_print"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="@string/action_test_print" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
