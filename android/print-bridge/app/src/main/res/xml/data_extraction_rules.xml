<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Print Bridge holds no user data worth backing up.  Every
         persisted setting is regenerable from Android system state
         (paired BT printers come from system settings; bridge port
         is a single int).  Excluding everything keeps the data
         extraction surface zero. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
